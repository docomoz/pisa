+
+/// One immutable waveform for sequential rereads using different prompts.
+/// Keep this object local to the clip and the lifetime of the loaded inference weights.
+public final class Qwen3ASRReusableAudio {
+    fileprivate let waveform: MaterializedArray
+    private weak var encoderModel: Qwen3ASRModel?
+    private var paddedLength = 0
+    private(set) var encoded: (features: MLXArray, tokenCount: Int)?
+    public private(set) var reuseCount = 0
+
+    public init(_ audio: MLXArray) {
+        waveform = audio.materialized()
+    }
+
+    fileprivate func encodeSingleChunk(_ chunk: MLXArray, using model: Qwen3ASRModel)
+        -> (features: MLXArray, tokenCount: Int)
+    {
+        // On the unsplit path the immutable waveform can only differ by right padding.
+        if encoderModel === model, paddedLength == chunk.dim(0), let encoded {
+            reuseCount += 1
+            return encoded
+        }
+        let result = model.encodeAudioChunk(chunk)
+        encoderModel = model
+        paddedLength = chunk.dim(0)
+        encoded = result
+        return result
+    }
 }

