# Managed by Pisya site deploy
[Unit]
Description=Pisya landing page
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pisya-site
Group=pisya-site
WorkingDirectory=/opt/pisya-site/current
ExecStart=/usr/bin/node /opt/pisya-site/current/scripts/serve.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
