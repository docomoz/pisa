# Managed by Pisa site deploy
[Unit]
Description=Pisa landing page
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pisa-site
Group=pisa-site
WorkingDirectory=/opt/pisa-site/current
ExecStart=/usr/bin/node /opt/pisa-site/current/scripts/serve.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
